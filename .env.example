# Copie ce fichier en ".env" puis remplace les valeurs (le fichier .env n'est PAS versionné)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bibliotheque
DB_USER=bibli_user
DB_PASS=change_moi
# SSL vers PostgreSQL : prefer (défaut, SSL si disponible) ou require (base hébergée qui l'impose)
DB_SSLMODE=prefer
